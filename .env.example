# Brilliox Marketing AI - Environment Variables

# ========== AI Services (Required) ==========
# يجب إضافة واحد على الأقل من المفاتيح التالية:

# OpenAI (Recommended)
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini (Alternative)
GOOGLE_API_KEY=your-google-api-key-here

# ========== Application Settings ==========
PORT=5000
DEBUG=true
APP_NAME=Brilliox Marketing AI
APP_VERSION=5.0.0

# ========== Database (Optional) ==========
# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/brilliox

# OR Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# ========== Facebook Integration (Optional) ==========
# للاستخدام المتقدم فقط - غير مطلوب لطريقة Boosted Posts
FACEBOOK_PAGE_ID=your-page-id
FACEBOOK_ACCESS_TOKEN=your-access-token

# ========== Payment (Optional) ==========
# Stripe for Global
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret

# ========== WhatsApp (Optional) ==========
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ========== Admin Settings ==========
ADMIN_PASSWORD=change_this_password_123
